# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit real keys.
# In GitHub Actions, add these as repository Secrets
# (Settings → Secrets and variables → Actions).

# Local raw DB (MySQL/MariaDB) — read-only profiling of cricket_raw
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_NAME=cricket_raw
DB_PASSWORD=

# Roanuz ball-by-ball API
ROANUZ_API_KEY=your_roanuz_api_key_here

# Odds feed (1x2bet or Parimatch — whichever is active)
ODDS_API_KEY=your_odds_api_key_here

# TheTopBookies publish API
PUBLISH_API_KEY=your_publish_api_key_here

# OpenAI (content generation)
OPENAI_API_KEY=

# Optional: weather API
WEATHER_API_KEY=your_weather_api_key_here
